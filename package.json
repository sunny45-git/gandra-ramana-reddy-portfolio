  "version": "1.0.0",
  "description": "Production-Ready Bilingual Politician Portfolio Website for Sri Gandra Venkata Ramana Reddy (MERN Stack & Netlify)",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "dev:backend": "node --watch backend/src/server.js",
    "server": "node --watch backend/src/server.js",
    "client": "cd frontend && npm run dev",
    "seed": "node backend/src/seed.js",
    "build": "cd frontend && npm install && npm run build",
    "build:netlify": "npm install && cd frontend && npm install && npm run build",
    "test:api": "node test-api.js"
  },
  "keywords": [
    "gandra-venkata-ramana-reddy",
